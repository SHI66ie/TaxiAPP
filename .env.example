# ===========================================
# Abuja Express Taxi – Environment Variables
# ===========================================
# Copy this file to .env (server) and admin-dashboard/.env
# Never commit real keys.

# ---------- Server (Node / Express) ----------
# Get these from Supabase → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Optional
PORT=5000

# ---------- Admin Dashboard (Vite) ----------
# Put these in admin-dashboard/.env
# VITE_ prefix is required for Vite to expose them to the browser
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Mapbox (required for Live Map)
# Free token: https://account.mapbox.com/access-tokens/
VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_public_token_here

# Optional – point the dashboard to a deployed backend instead of localhost
# VITE_API_URL=https://your-backend.railway.app
